POSTGRES_DB=jarvis_public
POSTGRES_USER=jarvis_public
POSTGRES_PORT=55432
POSTGRES_PASSWORD=<generated-random-local-secret>
DATABASE_URL=postgresql://jarvis_public:<generated-random-local-secret>@127.0.0.1:55432/jarvis_public
SESSION_SECRET=<generated-random-local-secret>
WIKI_REPO_ROOT=C:/absolute/path/to/jarvis/.runtime/wiki-repo
MINIO_ENDPOINT=http://127.0.0.1:59000
MINIO_ACCESS_KEY=<generated-random-local-secret>
MINIO_SECRET_KEY=<generated-random-local-secret>
MINIO_BUCKET=jarvis-public-sources
LLM_GATEWAY_URL=http://127.0.0.1:8317/v1
LLM_GATEWAY_KEY=<local-cli-proxy-bearer-secret>
ASK_AI_MODEL=gpt-5.6-terra
INGEST_AI_MODEL=gpt-5.6-sol
ASK_DAILY_BUDGET_USD=1
