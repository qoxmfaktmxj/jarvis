{
  "name": "@jarvis/web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "node --env-file=../../.env.local ./node_modules/next/dist/bin/next dev --port 3010",
    "build": "node --env-file=../../.env.local ./node_modules/next/dist/bin/next build",
    "start": "node --env-file=../../.env.local ./node_modules/next/dist/bin/next start --port 3010",
    "lint": "eslint . --max-warnings=0",
    "type-check": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "node --env-file=../../.env.local ./node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@jarvis/ai": "workspace:*",
    "@jarvis/auth": "workspace:*",
    "@jarvis/db": "workspace:*",
    "@jarvis/search": "workspace:*",
    "@jarvis/shared": "workspace:*",
    "@jarvis/storage": "workspace:*",
    "@jarvis/wiki-agent": "workspace:*",
    "@jarvis/wiki-fs": "workspace:*",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.468.0",
    "next": "15.5.21",
    "next-intl": "4.11.0",
    "pg-boss": "10.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "2.6.1",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@next/eslint-plugin-next": "15.5.18",
    "@playwright/test": "1.59.1",
    "@tailwindcss/postcss": "4.2.2",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "22.19.17",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "15.5.18",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "29.1.0",
    "postcss": "8.5.12",
    "pg": "8.20.0",
    "tailwindcss": "4.2.2",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
