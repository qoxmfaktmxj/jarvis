{
  "name": "@jarvis/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {},
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "project-once": "tsx src/project-once.ts",
    "eval:page-first": "tsx src/eval/page-first-qa.ts --fixture eval/fixtures/public-demo/page-first-qa.jsonl",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run src/jobs/__tests__/ingest-pipeline.integration.test.ts src/jobs/__tests__/projection.integration.test.ts src/jobs/__tests__/reconcile.integration.test.ts src/jobs/__tests__/demo-cleanup.integration.test.ts"
  },
  "dependencies": {
    "@jarvis/ai": "workspace:*",
    "@jarvis/auth": "workspace:*",
    "@jarvis/db": "workspace:*",
    "@jarvis/shared": "workspace:*",
    "@jarvis/storage": "workspace:*",
    "@jarvis/wiki-agent": "workspace:*",
    "@jarvis/wiki-fs": "workspace:*",
    "drizzle-orm": "0.45.2",
    "pg-boss": "10.1.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "@types/pg": "8.15.6",
    "pg": "8.20.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2",
    "vitest": "3.2.6"
  }
}
